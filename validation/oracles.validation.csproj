<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Oracles</RootNamespace>
    <AssemblyName>oracles.validation</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep build ordering without importing the Godot source generators a
         second time; this assembly only derives from already-generated types. -->
    <ProjectReference Include="..\oracles.csproj"
                      ReferenceOutputAssembly="false" />
    <PackageReference Include="GodotSharp" Version="4.7.1" />
    <Reference Include="oracles">
      <HintPath>..\.godot\mono\temp\bin\Debug\oracles.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Include="**\*.cs" Exclude="bin\**\*.cs;obj\**\*.cs" />
  </ItemGroup>
</Project>
